{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/story-result.schema.json",
  "title": "Story Generation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "template_id",
    "template_version",
    "model",
    "title_candidates",
    "sections",
    "warnings",
    "automated_validation_passed",
    "review_required"
  ],
  "properties": {
    "schema_version": { "const": "story-result-v1" },
    "language": { "enum": ["ko", "en", "ja", "zh"] },
    "template_id": { "type": "string", "pattern": "^t[0-9]{2}_[a-z0-9_]+$" },
    "template_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "model": { "type": "string", "minLength": 1 },
    "title_candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template_section_id",
          "type",
          "heading",
          "body",
          "source_fields",
          "image_intent"
        ],
        "properties": {
          "template_section_id": { "type": "string" },
          "type": { "type": "string" },
          "heading": { "type": "string" },
          "body": { "type": "string" },
          "source_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "image_intent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "purpose", "visual_hint", "source_fields"],
            "properties": {
              "required": { "type": "boolean" },
              "purpose": { "type": "string" },
              "visual_hint": { "type": "string" },
              "source_fields": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "section_id", "source_fields"],
        "properties": {
          "code": {
            "enum": [
              "unknown-source-field",
              "unlisted-number",
              "missing-template-section",
              "extra-template-section",
              "section-order-mismatch",
              "section-type-mismatch",
              "image-contract-mismatch",
              "missing-input",
              "schema-validation-error",
              "unsupported-future-commitment",
              "unsupported-generated-text",
              "source-role-imprecision",
              "internal-identifier-leak"
            ]
          },
          "message": { "type": "string", "minLength": 1 },
          "section_id": { "type": ["string", "null"] },
          "source_fields": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    },
    "automated_validation_passed": { "type": "boolean" },
    "review_required": { "const": true }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/story-category-module.schema.json",
  "title": "Funding Story Category Module",
  "description": "제품군에 반복되는 설명 영역과 미디어 프로필 연결을 설득 목적 템플릿과 분리해 관리한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "category",
    "product_types",
    "media_profile_ref",
    "media_section_bindings",
    "section_modules"
  ],
  "$defs": {
    "capability_group": {
      "enum": [
        "product_identity_outcome",
        "problem_environment",
        "cleaning_mechanism",
        "mobility_coverage",
        "automation_return",
        "control_personalization",
        "evidence_performance",
        "configuration_maintenance"
      ]
    },
    "content_placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "trigger", "title", "example", "input_format"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "trigger": {"enum": ["any_unknown", "all_unknown"]},
        "title": {"type": "string", "minLength": 1},
        "example": {"type": "string", "minLength": 1},
        "input_format": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "story-category-module-v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "category": {"type": "string", "minLength": 1},
    "product_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "media_profile_ref": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"},
    "media_section_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_identity_outcome",
        "problem_environment",
        "cleaning_mechanism",
        "mobility_coverage",
        "automation_return",
        "control_personalization",
        "evidence_performance",
        "configuration_maintenance"
      ],
      "properties": {
        "product_identity_outcome": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "problem_environment": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "cleaning_mechanism": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "mobility_coverage": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "automation_return": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "control_personalization": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "evidence_performance": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "configuration_maintenance": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    },
    "section_modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "after_stage",
          "activation_capability_groups",
          "section",
          "content_placeholder"
        ],
        "properties": {
          "after_stage": {
            "enum": ["introduction", "benefits_differentiation", "trust", "participation"]
          },
          "activation_capability_groups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/capability_group"}
          },
          "section": {
            "$ref": "https://funding-story-ai.local/schemas/story-template-section.schema.json"
          },
          "content_placeholder": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/content_placeholder"}
            ]
          }
        }
      }
    }
  }
}

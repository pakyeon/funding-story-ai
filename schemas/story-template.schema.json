{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/story-template.schema.json",
  "title": "Funding Story Template",
  "description": "스타일·콘텐츠 전략과 순서가 있는 섹션 골격을 분리해 관리하는 펀딩 스토리 템플릿이다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "template_name",
    "category",
    "language",
    "generation_source",
    "media_profile_ref",
    "target",
    "default_word_count",
    "narration_mode",
    "style",
    "content_strategy",
    "layout"
  ],
  "properties": {
    "schema_version": { "const": "funding-story-template-v1" },
    "id": { "type": "string", "pattern": "^t[0-9]{2}_[a-z0-9_]+$" },
    "template_name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "language": { "const": "ko" },
    "generation_source": {
      "enum": ["manual-analysis", "research-derived", "gemini-assisted"]
    },
    "media_profile_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]+$"
    },
    "target": { "type": "string", "minLength": 1 },
    "default_word_count": { "type": "integer", "minimum": 500, "maximum": 5000 },
    "narration_mode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tone_keywords",
        "sentence_style",
        "visual_mood",
        "color_palette",
        "font_style",
        "typography",
        "urgency_style",
        "cta_style"
      ],
      "properties": {
        "tone_keywords": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sentence_style": { "type": "string", "minLength": 1 },
        "visual_mood": { "type": "string", "minLength": 1 },
        "color_palette": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        },
        "font_style": { "type": "string", "minLength": 1 },
        "typography": { "type": "string", "minLength": 1 },
        "urgency_style": { "type": "string", "minLength": 1 },
        "cta_style": { "type": "string", "minLength": 1 }
      }
    },
    "content_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_message", "product_keywords", "success_metrics", "emphasis_phrases"],
      "properties": {
        "core_message": { "type": "string", "minLength": 1 },
        "product_keywords": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "success_metrics": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "emphasis_phrases": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "layout": {
      "type": "array",
      "minItems": 8,
      "maxItems": 14,
      "items": {
        "$ref": "https://funding-story-ai.local/schemas/story-template-section.schema.json"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/story-template.schema.json",
  "title": "Funding Story Template",
  "description": "제품군과 무관한 설득 목적, 스타일, 공통 4단계 스토리 골격을 관리한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "template_name",
    "language",
    "generation_source",
    "persuasion_axis",
    "target",
    "default_word_count",
    "narration_mode",
    "style",
    "content_strategy",
    "content_placeholders",
    "layout"
  ],
  "properties": {
    "schema_version": { "const": "funding-story-template-v2" },
    "id": { "type": "string", "pattern": "^t[0-9]{2}_[a-z0-9_]+$" },
    "template_name": { "type": "string", "minLength": 1 },
    "language": { "const": "ko" },
    "generation_source": {
      "enum": ["manual-analysis", "research-derived", "gemini-assisted"]
    },
    "persuasion_axis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "target": { "type": "string", "minLength": 1 },
    "default_word_count": { "type": "integer", "minimum": 500, "maximum": 5000 },
    "narration_mode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tone_keywords",
        "sentence_style",
        "visual_mood",
        "color_palette",
        "font_style",
        "typography",
        "urgency_style",
        "cta_style"
      ],
      "properties": {
        "tone_keywords": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sentence_style": { "type": "string", "minLength": 1 },
        "visual_mood": { "type": "string", "minLength": 1 },
        "color_palette": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        },
        "font_style": { "type": "string", "minLength": 1 },
        "typography": { "type": "string", "minLength": 1 },
        "urgency_style": { "type": "string", "minLength": 1 },
        "cta_style": { "type": "string", "minLength": 1 }
      }
    },
    "content_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_message", "product_keywords", "success_metrics", "emphasis_phrases"],
      "properties": {
        "core_message": { "type": "string", "minLength": 1 },
        "product_keywords": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "success_metrics": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "emphasis_phrases": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "content_placeholders": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fields", "trigger", "title", "example", "input_format"],
        "properties": {
          "fields": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "trigger": {"enum": ["any_unknown", "all_unknown"]},
          "title": {"type": "string", "minLength": 1},
          "example": {"type": "string", "minLength": 1},
          "input_format": {"type": "string", "minLength": 1}
        }
      }
    },
    "layout": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "https://funding-story-ai.local/schemas/story-template-section.schema.json"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/story-image-manifest.schema.json",
  "title": "Story Section Image Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "story_sha256",
    "reference_sha256",
    "model",
    "size",
    "quality",
    "requested",
    "succeeded",
    "failed",
    "assets"
  ],
  "properties": {
    "schema_version": { "const": "story-image-manifest-v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "story_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reference_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_mode": {
      "enum": ["reference-edit", "text-generate", "text-seeded-edit"]
    },
    "generated_seed_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": { "type": "string", "minLength": 1 },
    "size": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
    "quality": { "enum": ["low", "medium", "high"] },
    "requested": { "type": "integer", "minimum": 0 },
    "succeeded": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "status",
          "path",
          "sha256",
          "error_type",
          "qa_status",
          "qa_notes",
          "provider",
          "model",
          "mime_type",
          "attempts",
          "ai_metadata_embedded"
        ],
        "properties": {
          "section_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["success", "error"] },
          "path": { "type": ["string", "null"] },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "error_type": { "type": ["string", "null"] },
          "qa_status": { "enum": ["pending", "pass", "conditional", "fail"] },
          "qa_notes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "provider": {"type": ["string", "null"]},
          "model": {"type": ["string", "null"]},
          "mime_type": {
            "type": ["string", "null"],
            "enum": ["image/jpeg", "image/png", "image/webp", null]
          },
          "attempts": {"type": "integer", "minimum": 1},
          "ai_metadata_embedded": {"type": "boolean"}
        }
      }
    }
  }
}

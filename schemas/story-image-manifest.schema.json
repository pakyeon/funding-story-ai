{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/story-image-manifest.schema.json",
  "title": "Planned story image manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "media_plan_digest", "generation_package_digest",
    "primary_model", "fallback_model", "image_size", "aspect_ratio",
    "requested", "succeeded", "failed", "assets", "generated_references"
  ],
  "properties": {
    "schema_version": {"const": "story-image-manifest-v2"},
    "run_id": {"type": "string", "minLength": 1},
    "media_plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generation_package_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "primary_model": {"type": "string", "minLength": 1},
    "fallback_model": {"type": "string", "minLength": 1},
    "image_size": {"type": "string", "minLength": 1},
    "aspect_ratio": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "requested": {"type": "integer", "minimum": 0, "maximum": 8},
    "succeeded": {"type": "integer", "minimum": 0, "maximum": 8},
    "failed": {"type": "integer", "minimum": 0, "maximum": 8},
    "generated_references": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id", "roles", "description", "source_refs", "path", "sha256",
          "provider", "model", "mime_type", "attempts", "ai_metadata_embedded"
        ],
        "properties": {
          "asset_id": {"const": "asset_generated_product_reference"},
          "roles": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["product_body", "dock", "accessory"]}
          },
          "description": {"type": "string", "minLength": 1},
          "source_refs": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "mime_type": {"enum": ["image/jpeg", "image/png", "image/webp"]},
          "attempts": {"type": "integer", "minimum": 1, "maximum": 3},
          "ai_metadata_embedded": {"type": "boolean"}
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id", "section_id", "capability_group", "reference_asset_ids",
          "prompt_digest", "status", "path", "sha256", "error_type", "qa_status",
          "qa_notes", "review_checks", "provider", "model", "mime_type", "attempts",
          "ai_metadata_embedded"
        ],
        "properties": {
          "slot_id": {"type": "string", "pattern": "^slot_[a-z0-9_]+$"},
          "section_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "capability_group": {"type": "string", "minLength": 1},
          "reference_asset_ids": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "prompt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "status": {"enum": ["success", "error"]},
          "path": {"type": ["string", "null"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "error_type": {"type": ["string", "null"]},
          "qa_status": {"enum": ["pending", "pass", "conditional", "fail"]},
          "qa_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "review_checks": {
            "type": "object", "additionalProperties": false,
            "required": ["scene_distinctness", "product_fidelity", "text_legibility", "claim_grounding"],
            "properties": {
              "scene_distinctness": {"enum": ["pending", "pass", "fail", "not_applicable"]},
              "product_fidelity": {"enum": ["pending", "pass", "fail", "not_applicable"]},
              "text_legibility": {"enum": ["pending", "pass", "fail", "not_applicable"]},
              "claim_grounding": {"enum": ["pending", "pass", "fail", "not_applicable"]}
            }
          },
          "provider": {"type": ["string", "null"]},
          "model": {"type": ["string", "null"]},
          "mime_type": {
            "type": ["string", "null"],
            "enum": ["image/jpeg", "image/png", "image/webp", null]
          },
          "attempts": {"type": "integer", "minimum": 1, "maximum": 3},
          "ai_metadata_embedded": {"type": "boolean"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/story-intake-semantic-state.schema.json",
  "title": "Story intake semantic state and worker decision",
  "description": "대화 LLM이 추출한 제품 사실과 다음 대화 행동을 함께 표현한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_id",
    "language",
    "image_attached",
    "slots",
    "fact_conflict",
    "decision"
  ],
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "values", "source_turn"],
      "properties": {
        "status": {"enum": ["provided", "explicitly-absent", "unknown"]},
        "values": {"type": "array", "items": {"$ref": "#/$defs/non_empty_string"}},
        "source_turn": {"enum": ["initial", "followup", "none"]}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "story-intake-semantic-state-v2"},
    "input_id": {"$ref": "#/$defs/non_empty_string"},
    "language": {"enum": ["ko", "en", "ja", "zh"]},
    "image_attached": {"type": "boolean"},
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_name",
        "product_type",
        "category",
        "key_strengths",
        "target_supporters",
        "problem_context",
        "trust_elements",
        "maker_team_intro",
        "rewards",
        "funding_end",
        "shipping_start",
        "refund_policy",
        "as_policy",
        "funding_plan",
        "risk_response"
      ],
      "properties": {
        "product_name": {"$ref": "#/$defs/slot"},
        "product_type": {"$ref": "#/$defs/slot"},
        "category": {"$ref": "#/$defs/slot"},
        "key_strengths": {"$ref": "#/$defs/slot"},
        "target_supporters": {"$ref": "#/$defs/slot"},
        "problem_context": {"$ref": "#/$defs/slot"},
        "trust_elements": {"$ref": "#/$defs/slot"},
        "maker_team_intro": {"$ref": "#/$defs/slot"},
        "rewards": {"$ref": "#/$defs/slot"},
        "funding_end": {"$ref": "#/$defs/slot"},
        "shipping_start": {"$ref": "#/$defs/slot"},
        "refund_policy": {"$ref": "#/$defs/slot"},
        "as_policy": {"$ref": "#/$defs/slot"},
        "funding_plan": {"$ref": "#/$defs/slot"},
        "risk_response": {"$ref": "#/$defs/slot"}
      }
    },
    "fact_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authoritative_values", "superseded_values"],
      "properties": {
        "status": {"enum": ["none", "superseded-resolved", "unresolved"]},
        "authoritative_values": {
          "type": "array",
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "superseded_values": {
          "type": "array",
          "items": {"$ref": "#/$defs/non_empty_string"}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready_to_confirm", "requested_fields", "follow_up_question"],
      "properties": {
        "ready_to_confirm": {"type": "boolean"},
        "requested_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "product_name",
              "product_type",
              "category",
              "key_strengths",
              "target_supporters",
              "problem_context",
              "trust_elements",
              "maker_team_intro",
              "rewards",
              "funding_end",
              "shipping_start",
              "refund_policy",
              "as_policy",
              "funding_plan",
              "risk_response",
              "fact_conflict_resolution"
            ]
          }
        },
        "follow_up_question": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}

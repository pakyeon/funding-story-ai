{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/approved-generation-package.schema.json",
  "title": "Approved story generation package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_id",
    "thread_id",
    "approval",
    "brief",
    "brief_digest",
    "worker_projection",
    "worker_projection_digest",
    "entity_projection",
    "entity_projection_digest",
    "local_asset_paths"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "properties": {
    "schema_version": {"const": "approved-generation-package-v1"},
    "input_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary_version",
        "facts_revision",
        "collection_revision"
      ],
      "properties": {
        "status": {"const": "approved"},
        "summary_version": {"type": "integer", "minimum": 1},
        "facts_revision": {"type": "integer", "minimum": 0},
        "collection_revision": {"type": "integer", "minimum": 0}
      }
    },
    "brief": {"type": "object"},
    "brief_digest": {"$ref": "#/$defs/digest"},
    "worker_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_status",
        "summary_version",
        "facts_revision",
        "collection_revision",
        "brief_digest",
        "fact_states"
      ],
      "properties": {
        "approval_status": {"const": "approved"},
        "summary_version": {"type": "integer", "minimum": 1},
        "facts_revision": {"type": "integer", "minimum": 0},
        "collection_revision": {"type": "integer", "minimum": 0},
        "brief_digest": {"$ref": "#/$defs/digest"},
        "fact_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fact_id",
              "availability",
              "support_level",
              "collection_state",
              "revision"
            ],
            "properties": {
              "fact_id": {"type": "string", "pattern": "^f_[a-f0-9]{12}$"},
              "availability": {"enum": ["provided", "explicitly_absent", "unknown"]},
              "support_level": {"enum": ["supported", "maker_stated", "none", "rejected"]},
              "collection_state": {"enum": ["not_offered", "requested", "resolved", "skipped"]},
              "revision": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "worker_projection_digest": {"$ref": "#/$defs/digest"},
    "entity_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "brief_id", "facts", "sources", "evidence", "assets"],
      "properties": {
        "schema_version": {"const": "approved-entity-projection-v1"},
        "brief_id": {"type": "string", "minLength": 1},
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fact_id",
              "entity_id",
              "entity_kind",
              "statement",
              "source_refs",
              "evidence_refs",
              "asset_refs",
              "reference_roles"
            ],
            "properties": {
              "fact_id": {"type": "string", "pattern": "^f_[a-f0-9]{12}$"},
              "entity_id": {"type": "string", "minLength": 1},
              "entity_kind": {"enum": ["product", "problem", "feature", "claim", "evidence"]},
              "statement": {"type": "string", "minLength": 1},
              "source_refs": {"$ref": "#/$defs/reference_list"},
              "evidence_refs": {"$ref": "#/$defs/reference_list"},
              "asset_refs": {"$ref": "#/$defs/reference_list"},
              "reference_roles": {
                "type": "array",
                "uniqueItems": true,
                "items": {"enum": ["product_body", "dock", "accessory", "control_interface", "provided_evidence"]}
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "source_type", "description"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "source_type": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1}
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_id", "evidence_type", "description", "source_refs"],
            "properties": {
              "evidence_id": {"type": "string", "minLength": 1},
              "evidence_type": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "source_refs": {"$ref": "#/$defs/reference_list"}
            }
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset_id", "roles", "description", "source_refs"],
            "properties": {
              "asset_id": {"type": "string", "minLength": 1},
              "roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["product_body", "dock", "accessory", "control_interface", "provided_evidence"]}
              },
              "description": {"type": "string", "minLength": 1},
              "source_refs": {"$ref": "#/$defs/reference_list"}
            }
          }
        }
      }
    },
    "entity_projection_digest": {"$ref": "#/$defs/digest"},
    "local_asset_paths": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}

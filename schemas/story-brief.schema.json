{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/story-brief.schema.json",
  "title": "Story Generation Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "language",
    "source",
    "product",
    "audiences",
    "problems",
    "features",
    "claims",
    "evidence",
    "assets",
    "rewards",
    "schedule_policy",
    "unknowns"
  ],
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "location"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_type": {
          "enum": ["maker-input", "public-page", "document", "image", "test-report", "unknown"]
        },
        "location": { "type": "string", "minLength": 1 },
        "captured_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "value", "unit", "source_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^fact_[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "integer", "boolean"] },
        "unit": { "type": ["string", "null"] },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "story-brief-v1" },
    "brief_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "language": { "enum": ["ko", "en", "ja", "zh"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "project_url", "purpose", "snapshot_date", "refs"],
      "properties": {
        "project_id": { "type": ["string", "null"] },
        "project_url": { "type": ["string", "null"], "format": "uri" },
        "purpose": {
          "enum": ["reference-page-fixture", "maker-brief", "synthetic-fixture"]
        },
        "snapshot_date": { "type": "string", "format": "date" },
        "refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source_ref" } }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "product_type", "summary", "facts"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "product_type": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } }
      }
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "source_refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^aud_[a-z0-9_]+$" },
          "description": { "type": "string", "minLength": 1 },
          "source_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "source_refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^problem_[a-z0-9_]+$" },
          "description": { "type": "string", "minLength": 1 },
          "source_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "fact_ids", "evidence_ids", "source_refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^feature_[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "fact_ids": { "type": "array", "items": { "type": "string" } },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "status", "evidence_ids", "source_refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^claim_[a-z0-9_]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "status": { "enum": ["supported", "page-stated-unverified", "maker-stated-unverified", "rejected"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidence_type", "description", "supports_claim_ids", "source_refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^evidence_[a-z0-9_]+$" },
          "evidence_type": { "enum": ["test-report", "certification", "award", "insurance", "review", "demonstration", "page-copy"] },
          "description": { "type": "string", "minLength": 1 },
          "supports_claim_ids": { "type": "array", "items": { "type": "string" } },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "asset_type", "description", "allowed_sections", "source_refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^asset_[a-z0-9_]+$" },
          "asset_type": { "enum": ["product", "lifestyle", "feature", "app", "brand", "evidence", "reward"] },
          "description": { "type": "string", "minLength": 1 },
          "allowed_sections": { "type": "array", "items": { "type": "string" } },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "price_krw", "quantity", "components", "source_refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^reward_[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "price_krw": { "type": ["integer", "null"], "minimum": 0 },
          "quantity": { "type": ["integer", "null"], "minimum": 0 },
          "components": { "type": "array", "items": { "type": "string" } },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "schedule_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["funding_end", "shipping_start", "refund_policy", "as_policy", "source_refs"],
      "properties": {
        "funding_end": { "type": ["string", "null"], "format": "date" },
        "shipping_start": { "type": ["string", "null"], "format": "date" },
        "refund_policy": { "type": ["string", "null"] },
        "as_policy": { "type": ["string", "null"] },
        "source_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "question", "blocks_sections"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "blocks_sections": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

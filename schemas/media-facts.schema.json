{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/media-facts.schema.json",
  "title": "Normalized media facts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "approved_revision",
    "brief_digest",
    "worker_projection_digest",
    "propositions",
    "facts",
    "sources",
    "evidence",
    "assets",
    "ignored_fact_ids"
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capability_group": {
      "enum": [
        "product_identity_outcome",
        "problem_environment",
        "cleaning_mechanism",
        "mobility_coverage",
        "automation_return",
        "control_personalization",
        "evidence_performance",
        "configuration_maintenance"
      ]
    },
    "reference_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "properties": {
    "schema_version": {"const": "media-facts-v1"},
    "brief_id": {"type": "string", "minLength": 1},
    "approved_revision": {"type": "integer", "minimum": 0},
    "brief_digest": {"$ref": "#/$defs/digest"},
    "worker_projection_digest": {"$ref": "#/$defs/digest"},
    "propositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposition_id", "fact_id", "text", "capability_group"],
        "properties": {
          "proposition_id": {"type": "string", "pattern": "^p_[a-f0-9]{12}$"},
          "fact_id": {"type": "string", "pattern": "^f_[a-f0-9]{12}$"},
          "text": {"type": "string", "minLength": 1},
          "capability_group": {"$ref": "#/$defs/capability_group"}
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "proposition_ids",
          "source_refs",
          "evidence_refs",
          "asset_refs",
          "reference_roles",
          "availability",
          "support_level",
          "collection_state"
        ],
        "properties": {
          "fact_id": {"type": "string", "pattern": "^f_[a-f0-9]{12}$"},
          "proposition_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^p_[a-f0-9]{12}$"}
          },
          "source_refs": {"$ref": "#/$defs/reference_list"},
          "evidence_refs": {"$ref": "#/$defs/reference_list"},
          "asset_refs": {"$ref": "#/$defs/reference_list"},
          "reference_roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["product_body", "dock", "accessory", "control_interface", "provided_evidence"]}
          },
          "availability": {"enum": ["provided", "explicitly_absent", "unknown"]},
          "support_level": {"enum": ["supported", "maker_stated", "none", "rejected"]},
          "collection_state": {"enum": ["not_offered", "requested", "resolved", "skipped"]}
        }
      }
    },
    "sources": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "assets": {"type": "array", "items": {"type": "object"}},
    "ignored_fact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^f_[a-f0-9]{12}$"}
    }
  }
}

GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_PRIMARY_ACCESS_ATTEMPTS=5
GEMINI_REQUEST_TIMEOUT_MS=120000
GEMINI_MAX_OUTPUT_TOKENS=24576
GEMINI_THINKING_LEVEL=MEDIUM

GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_SIZE=1K
GEMINI_IMAGE_ASPECT_RATIO=3:2
GEMINI_IMAGE_MIME_TYPE=image/jpeg
GEMINI_IMAGE_COMPRESSION=85
IMAGE_PRIMARY_ATTEMPTS=2
IMAGE_FALLBACK_ATTEMPTS=1
IMAGE_REQUEST_INTERVAL_SECONDS=3
IMAGE_RETRY_BASE_SECONDS=10
IMAGE_RETRY_MAX_SECONDS=30
IMAGE_RETRY_JITTER_SECONDS=2
IMAGE_FALLBACK_DELAY_SECONDS=10

# 템플릿 검색과 로컬 MCP 실행 저장소
TEMPLATE_CATEGORY_BOOST=0.15
STORY_MCP_RUN_STORE=artifacts/runs

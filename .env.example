GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

GEMINI_PRIMARY_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_PRIMARY_ACCESS_ATTEMPTS=5
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_THINKING_LEVEL=LOW

OPENAI_API_KEY=your-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
OPENAI_IMAGE_OUTPUT_COMPRESSION=85
GEMINI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image
IMAGE_ATTEMPTS_PER_PROVIDER=3

# 템플릿 검색과 로컬 MCP 실행 저장소
TEMPLATE_CATEGORY_BOOST=0.15
STORY_MCP_RUN_STORE=artifacts/runs
